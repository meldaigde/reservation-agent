MODEL=
# Optional: used when the first model fails
FALLBACK_MODEL=
# Optional: another OpenAI-compatible provider, for example https://api.groq.com/openai/v1
# (put that provider's key in OPENROUTER_API_KEY)
LLM_BASE_URL=

BUSINESS_NAME=Demo Cafe
OPENING_TIME=09:00
CLOSING_TIME=23:00
MAX_PARTY_SIZE=12
SEAT_CAPACITY=30
DB_PATH=reservations.db
